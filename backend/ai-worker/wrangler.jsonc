{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "spectra-pro-ai",
  "main": "src/index.js",
  "compatibility_date": "2026-09-16",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "ALLOWED_ORIGINS": "https://toffaboffa.github.io,http://localhost:8000,http://127.0.0.1:8000",
    "MAX_BODY_BYTES": "65536",
    "OPENAI_MODEL": "gpt-5.6-terra",
    "OPENAI_TIMEOUT_MS": "35000",
    "OPENAI_MAX_OUTPUT_TOKENS": "700"
  },
  "secrets_store_secrets": [
    {
      "binding": "OPENAI_API_KEY",
      "store_id": "d9f7cbec558849968e30aaee8a7f8dd6",
      "secret_name": "SpectraPRO"
    }
  ],
  "ratelimits": [
    {
      "name": "AI_RATE_LIMITER",
      "namespace_id": "2026091601",
      "simple": {
        "limit": 12,
        "period": 60
      }
    }
  ]
}
